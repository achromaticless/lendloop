{
  "name": "LendLoop - Request notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop-events",
        "authentication": "jwtAuth",
        "responseMode": "responseNode",
        "options": { "rawBody": true }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Convex webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "5b3c8e0a-1d7e-4f6a-9a55-lendloop0001",
      "credentials": { "jwtAuth": { "id": "lendloopWebhookCred", "name": "LendLoop webhook (Convex to n8n)" } }
    },
    {
      "parameters": {
        "action": "hash",
        "binaryData": true,
        "binaryPropertyName": "data",
        "type": "SHA256",
        "dataPropertyName": "bodyHash",
        "encoding": "hex"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Hash raw body",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "decode",
        "token": "={{ $('Convex webhook').item.json.headers.authorization.replace('Bearer ', '') }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Read signed hash",
      "type": "n8n-nodes-base.jwt",
      "typeVersion": 1,
      "position": [440, 0],
      "credentials": { "jwtAuth": { "id": "lendloopWebhookCred", "name": "LendLoop webhook (Convex to n8n)" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Hash raw body').item.json.bodyHash }}",
              "rightValue": "={{ $json.payload.bh }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Body matches signed hash?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "unauthorized",
        "options": { "responseCode": 401 }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [880, 160]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "ok",
        "options": { "responseCode": 200 }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Accept",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [880, -80]
    },
    {
      "parameters": {
        "operation": "sign",
        "useJson": true,
        "claimsJson": "={{ JSON.stringify({ iss: 'n8n', iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 300, jti: $execution.id, m: 'GET', p: '/n8n/notification?eventId=' + $('Convex webhook').item.json.body.eventId, bh: 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' }) }}",
        "headerClaims": "{}",
        "options": { "algorithm": "HS256" }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Sign details request",
      "type": "n8n-nodes-base.jwt",
      "typeVersion": 1,
      "position": [1100, -80],
      "credentials": { "jwtAuth": { "id": "lendloopApiCred", "name": "LendLoop API (n8n to Convex)" } }
    },
    {
      "parameters": {
        "url": "={{ 'https://trustworthy-chihuahua-9.convex.site/n8n/notification?eventId=' + $('Convex webhook').item.json.body.eventId }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.token }}" }] },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Get recipient details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -80],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.alreadySent }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Already sent? (duplicate run)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1540, -80]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "subject",
              "type": "string",
              "value": "={{ ({ created: 'New request for your ' + $json.toolName, approved: 'Approved: ' + $json.toolName, declined: 'Declined: ' + $json.toolName, cancelled: 'Cancelled: ' + $json.toolName, returned: 'Returned: ' + $json.toolName })[$json.type] }}"
            },
            {
              "id": "s2",
              "name": "text",
              "type": "string",
              "value": "={{ 'Hi ' + $json.toName + ',\\n\\n' + ({ created: $json.otherName + ' would like to borrow your ' + $json.toolName + ' from ' + $json.startDate + ' to ' + $json.endDate + '. Open LendLoop to approve or decline.', approved: $json.otherName + ' approved your request for ' + $json.toolName + ' (' + $json.startDate + ' to ' + $json.endDate + '). Open LendLoop for the pick-up details.', declined: $json.otherName + ' declined your request for ' + $json.toolName + '.', cancelled: $json.recipientRole === 'owner' ? $json.otherName + ' cancelled their request for your ' + $json.toolName + '.' : 'Your request for ' + $json.toolName + ' was cancelled because the tool is no longer available.', returned: $json.otherName + ' marked ' + $json.toolName + ' as returned. Thank you for using LendLoop.' })[$json.type] + '\\n\\nLendLoop' }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Write the email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1760, 0]
    },
    {
      "parameters": {
        "fromEmail": "LendLoop <REPLACE_WITH_VERIFIED_SENDER>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": { "appendAttribution": false }
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1980, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "credentials": { "smtp": { "id": "lendloopSmtp", "name": "LendLoop SMTP" } }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m1", "name": "status", "type": "string", "value": "sent" },
            { "id": "m2", "name": "body", "type": "string", "value": "={{ JSON.stringify({ eventId: $('Convex webhook').item.json.body.eventId, status: 'sent' }) }}" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Mark sent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2200, -80]
