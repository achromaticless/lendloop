      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m3", "name": "status", "type": "string", "value": "failed" },
            { "id": "m4", "name": "body", "type": "string", "value": "={{ JSON.stringify({ eventId: $('Convex webhook').item.json.body.eventId, status: 'failed' }) }}" }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Mark failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2200, 120]
    },
    {
      "parameters": {
        "action": "hash",
        "binaryData": false,
        "value": "={{ $json.body }}",
        "type": "SHA256",
        "dataPropertyName": "bodyHash",
        "encoding": "hex"
      },
      "id": "a1000000-0000-4000-8000-000000000014",
      "name": "Hash result body",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [2420, 0]
    },
    {
      "parameters": {
        "operation": "sign",
        "useJson": true,
        "claimsJson": "={{ JSON.stringify({ iss: 'n8n', iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 300, jti: $execution.id, m: 'POST', p: '/n8n/notification-result', bh: $json.bodyHash }) }}",
        "headerClaims": "{}",
        "options": { "algorithm": "HS256" }
      },
      "id": "a1000000-0000-4000-8000-000000000015",
      "name": "Sign result",
      "type": "n8n-nodes-base.jwt",
      "typeVersion": 1,
      "position": [2640, 0],
      "credentials": { "jwtAuth": { "id": "lendloopApiCred", "name": "LendLoop API (n8n to Convex)" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://trustworthy-chihuahua-9.convex.site/n8n/notification-result",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.token }}" }] },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $('Hash result body').item.json.body }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000016",
      "name": "Report result to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c3",
              "leftValue": "={{ $('Hash result body').item.json.status }}",
              "rightValue": "failed",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000017",
      "name": "Email failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3080, 0]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'Could not send the notification email for event ' + $('Convex webhook').item.json.body.eventId }}"
      },
      "id": "a1000000-0000-4000-8000-000000000018",
      "name": "Fail the run (alerts the error workflow)",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [3300, -60]
    }
  ],
