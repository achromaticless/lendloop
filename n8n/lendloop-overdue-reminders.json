{
  "name": "LendLoop - Overdue reminders",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 9 }] }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "sign",
        "useJson": true,
        "claimsJson": "={{ JSON.stringify({ iss: 'n8n', iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 300, jti: $execution.id, m: 'GET', p: '/n8n/overdue', bh: 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' }) }}",
        "headerClaims": "{}",
        "options": { "algorithm": "HS256" }
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Sign overdue request",
      "type": "n8n-nodes-base.jwt",
      "typeVersion": 1,
      "position": [220, 0],
      "credentials": { "jwtAuth": { "id": "lendloopApiCred", "name": "LendLoop API (n8n to Convex)" } }
    },
    {
      "parameters": {
        "url": "https://trustworthy-chihuahua-9.convex.site/n8n/overdue",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.token }}" }] },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Get overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": { "fieldToSplitOut": "loans", "options": {} },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [660, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "body", "type": "string", "value": "={{ JSON.stringify({ requestId: $json.requestId }) }}" }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Claim body",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 0]
    },
    {
      "parameters": {
        "action": "hash",
        "binaryData": false,
        "value": "={{ $json.body }}",
        "type": "SHA256",
        "dataPropertyName": "bodyHash",
        "encoding": "hex"
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Hash claim body",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "operation": "sign",
        "useJson": true,
        "claimsJson": "={{ JSON.stringify({ iss: 'n8n', iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 300, jti: $execution.id + '-' + $itemIndex, m: 'POST', p: '/n8n/reminders/claim', bh: $json.bodyHash }) }}",
        "headerClaims": "{}",
        "options": { "algorithm": "HS256" }
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Sign claim",
      "type": "n8n-nodes-base.jwt",
      "typeVersion": 1,
      "position": [1320, 0],
      "credentials": { "jwtAuth": { "id": "lendloopApiCred", "name": "LendLoop API (n8n to Convex)" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://trustworthy-chihuahua-9.convex.site/n8n/reminders/claim",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.token }}" }] },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $('Hash claim body').item.json.body }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Claim today's reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.claimed }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Did we win the claim?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1760, 0]
    },
    {
      "parameters": {
        "fromEmail": "LendLoop <REPLACE_WITH_VERIFIED_SENDER>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ 'Reminder: please return ' + $json.toolName }}",
        "emailFormat": "text",
        "text": "={{ 'Hi ' + $json.toName + ',\\n\\nThe ' + $json.toolName + ' you borrowed from ' + $json.ownerName + ' was due back on ' + $json.endDate + '. Please return it as soon as you can.\\n\\nLendLoop' }}",
        "options": { "appendAttribution": false }
      },
      "id": "b2000000-0000-4000-8000-000000000010",
      "name": "Send reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1980, -80],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "credentials": { "smtp": { "id": "lendloopSmtp", "name": "LendLoop SMTP" } }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m1", "name": "status", "type": "string", "value": "sent" },
            { "id": "m2", "name": "body", "type": "string", "value": "={{ JSON.stringify({ reminderId: $('Claim today\\'s reminder').item.json.reminderId, status: 'sent' }) }}" }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000011",
      "name": "Mark sent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2200, -160]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m3", "name": "status", "type": "string", "value": "failed" },
            { "id": "m4", "name": "body", "type": "string", "value": "={{ JSON.stringify({ reminderId: $('Claim today\\'s reminder').item.json.reminderId, status: 'failed', error: 'email could not be sent' }) }}" }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000012",
      "name": "Mark failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2200, 40]
    },
    {
      "parameters": {
        "action": "hash",
        "binaryData": false,
        "value": "={{ $json.body }}",
        "type": "SHA256",
        "dataPropertyName": "bodyHash",
        "encoding": "hex"
      },
      "id": "b2000000-0000-4000-8000-000000000013",
      "name": "Hash result body",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [2420, -80]
    },
    {
      "parameters": {
        "operation": "sign",
        "useJson": true,
        "claimsJson": "={{ JSON.stringify({ iss: 'n8n', iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 300, jti: $execution.id + '-r-' + $itemIndex, m: 'POST', p: '/n8n/reminders/result', bh: $json.bodyHash }) }}",
        "headerClaims": "{}",
        "options": { "algorithm": "HS256" }
      },
      "id": "b2000000-0000-4000-8000-000000000014",
      "name": "Sign result",
      "type": "n8n-nodes-base.jwt",
      "typeVersion": 1,
      "position": [2640, -80],
      "credentials": { "jwtAuth": { "id": "lendloopApiCred", "name": "LendLoop API (n8n to Convex)" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://trustworthy-chihuahua-9.convex.site/n8n/reminders/result",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.token }}" }] },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $('Hash result body').item.json.body }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000015",
      "name": "Report result to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, -80],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $('Hash result body').item.json.status }}",
              "rightValue": "failed",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000016",
      "name": "Email failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3080, -80]
    },
    {
      "parameters": {
        "errorMessage": "Could not send an overdue reminder email"
      },
      "id": "b2000000-0000-4000-8000-000000000017",
      "name": "Fail the run (alerts the error workflow)",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [3300, -140]
    }
  ],
  "connections": {
